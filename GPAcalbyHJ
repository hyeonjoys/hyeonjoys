# CLI 버전의 함수들을 Streamlit에 맞게 수정 (print 제거, 데이터 반환)

def calculate_gpa(df_grades):
    """(로직 동일) 평점을 계산하고 관련 DataFrame과 값들을 반환합니다."""
    if df_grades.empty:
        return pd.DataFrame(), 0.0, 0, pd.DataFrame()

    df_calc = df_grades[
        (df_grades['성적'] != 'P') & (df_grades['성적'] != 'NP') & (df_grades['학점'] > 0)
        ].copy()

    total_credits_earned = df_grades[
        (df_grades['성적'] != 'F') & (df_grades['성적'] != 'NP')
        ]['학점'].sum()

    if df_calc.empty:
        retake_subjects = df_grades[
            (df_grades['성적'].isin(['C+', 'C0', 'D+', 'D0', 'F']))
        ][['이수시기', '과목명', '성적', '구분']]
        return retake_subjects, 0.0, total_credits_earned, pd.DataFrame()

    df_calc['점수'] = df_calc['성적'].map(GRADE_MAP)
    df_calc['총점'] = df_calc['학점'] * df_calc['점수']

    total_gpa = 0.0
    if df_calc['학점'].sum() > 0:
        total_gpa = df_calc['총점'].sum() / df_calc['학점'].sum()

    gpa_by_group = pd.DataFrame()
    if not df_calc.empty:
        gpa_by_group = df_calc.groupby('구분').agg(
            총이수학점=('학점', 'sum'),
            총점합계=('총점', 'sum')
        )
        gpa_by_group['평균평점'] = (gpa_by_group['총점합계'] / gpa_by_group['총이수학점']).round(2)

    retake_subjects = df_grades[
        (df_grades['성적'].isin(['C+', 'C0', 'D+', 'D0', 'F']))
    ][['이수시기', '과목명', '성적', '구분']]

    return retake_subjects, total_gpa, total_credits_earned, gpa_by_group


def analyze_gtm_track(df_grades, selected_track):
    """(수정) GTM 트랙 분석 결과를 '출력'하는 대신 '반환'합니다."""

    # 1. (A) 트랙 전체 과목
    try:
        track_subjects_set = {s.strip().lower() for s in TRACK_COURSES[selected_track]}
        original_track_subjects_map = {s.strip().lower(): s for s in TRACK_COURSES[selected_track]}
    except KeyError:
        return None, None, None, None, None  # 오류 시 None 반환

    # 2. (B) 내가 이수한 과목
    passed_subjects_map = {
        row['과목명'].strip().lower(): row['성적']
        for _, row in df_grades.iterrows()
        if (row['성적'] != 'F' and row['성적'] != 'NP')
    }
    passed_subjects_set = set(passed_subjects_map.keys())

    # 3. 이수한 트랙 과목 (교집합)
    passed_track_subjects_norm = track_subjects_set.intersection(passed_subjects_set)

    passed_track_list = []
    for sub_norm in sorted(list(passed_track_subjects_norm)):
        original_name = original_track_subjects_map[sub_norm]
        grade = passed_subjects_map[sub_norm]
        passed_track_list.append(f"{original_name} ( {grade} )")  # 리스트로 반환

    # 4. 트랙 평점 계산
    df_track_calc = df_grades[
        (df_grades['과목명'].str.strip().str.lower().isin(passed_track_subjects_norm)) &
        (df_grades['성적'] != 'P') & (df_grades['성적'] != 'NP') & (df_grades['학점'] > 0)
        ].copy()

    track_gpa = 0.0
    track_credits = 0
    if not df_track_calc.empty:
        df_track_calc['점수'] = df_track_calc['성적'].map(GRADE_MAP)
        df_track_calc['총점'] = df_track_calc['학점'] * df_track_calc['점수']

        if df_track_calc['학점'].sum() > 0:
            track_gpa = df_track_calc['총점'].sum() / df_track_calc['학점'].sum()
        track_credits = df_track_calc['학점'].sum()

    # 5. 미이수 트랙 과목 (차집합)
    missing_track_subjects = track_subjects_set - passed_subjects_set
    missing_track_list = [
        original_track_subjects_map[sub_norm]
        for sub_norm in sorted(list(missing_track_subjects))
    ]

    return passed_track_list, missing_track_list, track_gpa, track_credits, len(track_subjects_set)


