def load_dataframe(filename, columns):
    if os.path.exists(filename):
        try:
            return pd.read_csv(filename)
        except pd.errors.EmptyDataError:
            return pd.DataFrame(columns=columns)
        except Exception as e:
            st.error(f"'{filename}' 로드 중 오류 발생: {e}")
            return pd.DataFrame(columns=columns)
    else:
        return pd.DataFrame(columns=columns)


def save_dataframe(df, filename):
    try:
        df.to_csv(filename, index=False)
        # st.success(f"데이터가 '{filename}'에 저장되었습니다.") # 알림이 너무 자주 떠서 주석 처리
    except Exception as e:
        st.error(f"'{filename}' 저장 중 오류 발생: {e}")


def load_config():
    if not os.path.exists(CONFIG_FILE):
        st.warning(f"'{CONFIG_FILE}' 파일이 없어 기본 설정으로 새로 생성합니다.")
        default_config = {
            "requirements": {
                "총학점": 130,
                "전공학점": 72,
                "필수과목": [
                    "Introduction to Information Technology and Programming",
                    "Principles of Accounting",
                    "Principles of Economics(Micro)",
                    "Statistics for Business",
                    "Analysis and Understanding of Business Data",
                    "Management and Entrepreneurship",
                    "파이썬입문"
                ],
                "EPIC점수": 700
            },
            "current_epic": 0
        }
        with open(CONFIG_FILE, 'w', encoding='utf-8') as f:
            json.dump(default_config, f, indent=4, ensure_ascii=False)
        return default_config["requirements"], default_config["current_epic"]

    try:
        with open(CONFIG_FILE, 'r', encoding='utf-8') as f:
            config_data = json.load(f)
            if "requirements" not in config_data:
                config_data["requirements"] = {"총학점": 130, "전공학점": 72, "필수과목": [], "EPIC점수": 700}
            if "current_epic" not in config_data:
                config_data["current_epic"] = 0

            if config_data["requirements"].get("EPIC점수", 0) != 700:
                config_data["requirements"]["EPIC점수"] = 700
                st.info(f"'{CONFIG_FILE}'의 EPIC 목표 점수를 700점으로 업데이트했습니다.")
                save_config(config_data["requirements"], config_data["current_epic"])

            return config_data["requirements"], config_data["current_epic"]
    except Exception as e:
        st.error(f"'{CONFIG_FILE}' 로드 중 오류 발생: {e}")
        return {
            "총학점": 130, "전공학점": 72,
            "필수과목": [
                "Introduction to Information Technology and Programming",
                "Principles of Accounting",
                "Principles of Economics(Micro)",
                "Statistics for Business",
                "Analysis and Understanding of Business Data",
                "Management and Entrepreneurship",
                "파이썬입문"
            ],
            "EPIC점수": 700
        }, 0


