# st.session_state : Streamlit이 페이지 새로고침/상호작용 시 데이터를 기억하게 하는 변수

def initialize_session():
    """앱이 처음 로드될 때 한 번만 실행되어 데이터를 불러옵니다."""
    if 'initialized' not in st.session_state:
        # 컬럼 정의
        grade_columns = ['과목명', '학점', '성적', '구분', '이수시기']
        spec_columns = ['분류', '이름', '상세', '시기']

        # 데이터 로드
        st.session_state.df_grades = load_dataframe(GRADE_FILE, columns=grade_columns)
        st.session_state.df_specs = load_dataframe(SPEC_FILE, columns=spec_columns)
        requirements, current_epic = load_config()
        st.session_state.requirements = requirements
        st.session_state.current_epic = current_epic

        # 무결성 검사
        for col in grade_columns:
            if col not in st.session_state.df_grades.columns:
                st.session_state.df_grades[col] = pd.NA
        for col in spec_columns:
            if col not in st.session_state.df_specs.columns:
                st.session_state.df_specs[col] = pd.NA

        st.session_state.initialized = True  # 초기화 완료 플래그


